# Copy to .env and fill in (cp .env.example .env). Never commit .env.

# --- Microsoft Foundry / Azure OpenAI (required) -----------------------------
# Foundry portal -> your project -> Models + endpoints -> gpt-4o -> "Target URI".
# The full Target URI is fine; the server keeps only the origin, e.g.
# https://my-resource.openai.azure.com or https://my-resource.cognitiveservices.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The *deployment name* you gave the model in Foundry (not the model id).
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Only used on the legacy route. The client first tries the Foundry v1 route
# (<endpoint>/openai/v1/) and falls back to this automatically on a 404.
AZURE_OPENAI_API_VERSION=2024-10-21
# Set to true to force the legacy Azure OpenAI route from the start.
AZURE_OPENAI_LEGACY_API=false

# --- Optional: hybrid retrieval ----------------------------------------------
# If you also deploy an embedding model (e.g. text-embedding-3-small), set its
# deployment name here and retrieval becomes lexical + embeddings. Leave blank
# for pure lexical retrieval (works fine for a single profile document).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Alternative provider: OpenAI platform -----------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Server ------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API (your GitHub Pages
# URL and/or custom domain). localhost is always allowed.
ALLOWED_ORIGINS=https://simrann-ux.github.io
RATE_LIMIT_PER_MINUTE=20
RAG_TOP_K=5
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600
# Append every question/answer to logs/questions.jsonl
LOG_QUESTIONS=false
# Serve the portfolio HTML from the repo root at / for local testing.
SERVE_FRONTEND=true
